---
import GalleryGrid from './GalleryGrid.astro';
import CtaBand from './CtaBand.astro';
import { getContent, getGallery, getImage, type Lang } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const items = getGallery(lang);
const heroImage = getImage('gallery-bread');
const galleryCount = items.length + 1;
---

<section class="page-hero">
  <div class="wrap page-hero__grid">
    <div class="page-hero__text">
      <h1>{t.galleryPage.title}</h1>
      <p class="page-hero__lead">{t.galleryPage.lead}</p>
      <p class="page-hero__meta">
        {galleryCount} {t.galleryPage.countLabel}
      </p>
    </div>

    <figure class="page-hero__figure">
      <button
        class="lightbox-trigger"
        type="button"
        data-lightbox={heroImage.full}
        data-lightbox-alt={heroImage.alt[lang]}
        data-lightbox-caption={heroImage.alt[lang]}
        data-lightbox-group="gallery"
        aria-label={`${t.lightbox.open}: ${heroImage.alt[lang]}`}
      >
        <img
          src={heroImage.src}
          srcset={heroImage.srcset}
          sizes="(max-width: 960px) 100vw, 40rem"
          width={heroImage.width}
          height={heroImage.height}
          alt=""
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </button>
    </figure>
  </div>
</section>

<section class="gallery-section">
  <div class="wrap">
    <GalleryGrid items={items} labels={t.lightbox} />
  </div>
</section>

<CtaBand
  title={t.galleryPage.ctaTitle}
  lead={t.galleryPage.ctaLead}
  button={t.galleryPage.ctaButton}
  newWindow={t.newWindow}
/>
