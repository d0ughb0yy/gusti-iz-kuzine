---
import Icon from './Icon.astro';
import CtaBand from './CtaBand.astro';
import ContactPanel from './ContactPanel.astro';
import { routes, site } from '../config';
import { getContent, getGallery, getImage, type Lang } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);

const heroImage = getImage(t.hero.image);
const portraitImage = getImage('chef-portrait');
const actionImage = getImage('chef-action');
const allGallery = getGallery(lang);
const heroName = t.hero.name.join(' ');
// A renamed or missing teaser key must fail the build, not silently render
// a broken grid.
const teaserItems = t.galleryTeaser.images.map((key) => {
  const item = allGallery.find((galleryItem) => galleryItem.imageKey === key);
  if (!item) throw new Error(`Unknown image key in galleryTeaser: ${key}`);
  return item;
});
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero__media">
    <img
      src={heroImage.src}
      srcset={heroImage.srcset}
      sizes="100vw"
      width={heroImage.width}
      height={heroImage.height}
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content">
    <h1 class="hero__name" id="hero-name">{heroName}</h1>
    <p class="hero__lead">{t.hero.lead}</p>

    <div class="hero__actions">
      <a
        class="btn btn--light"
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.hero.primaryCta}
        <Icon name="arrow-right" />
      </a>
      <a class="hero__link" href="#jelovnici">{t.hero.secondaryCta}</a>
    </div>

    <p class="hero__note">{t.hero.bookingNote}</p>
  </div>
</section>

<section class="section story" id="o-kuhanju" aria-labelledby="story-title">
  <div class="wrap story__grid">
    <figure class="story__figure">
      <button
        class="lightbox-trigger"
        type="button"
        data-lightbox={portraitImage.full}
        data-lightbox-alt={portraitImage.alt[lang]}
        data-lightbox-caption={t.intro.who.name}
        aria-label={`${t.lightbox.open}: ${t.intro.who.name}`}
      >
        <img
          src={portraitImage.src}
          srcset={portraitImage.srcset}
          sizes="(max-width: 960px) 100vw, 34rem"
          width={portraitImage.width}
          height={portraitImage.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </button>
    </figure>

    <div class="story__text">
      <h2 id="story-title">{t.intro.title}</h2>

      <div class="story__paragraphs">
        {t.intro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="story__byline">
        <p class="story__name">{t.intro.who.name}</p>
        <p class="story__fact">{t.intro.who.fact}</p>
      </div>

      <a class="link-arrow" href="#tijek">
        {t.intro.link}
        <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</section>

<section class="section menus" id="jelovnici" aria-labelledby="menus-title">
  <div class="wrap">
    <div class="menus__head">
      <h2 id="menus-title">{t.menus.title}</h2>
      <p class="menus__lead">{t.menus.lead}</p>
    </div>

    <div class="menu-explorer">
      <div class="menu-tabs" role="group" aria-label={t.menus.selectLabel}>
        {
          t.menus.items.map((menu, index) => (
            <button
              class="menu-tab"
              type="button"
              aria-pressed={index === 0 ? 'true' : 'false'}
              aria-controls={`menu-panel-${index}`}
              data-menu-tab={index}
            >
              {menu.name}
              <span class="menu-tab__desc">{menu.description}</span>
            </button>
          ))
        }
      </div>

      <div class="menu-panels">
        {
          t.menus.items.map((menu, index) => (
            <div
              class="menu-panel"
              id={`menu-panel-${index}`}
              data-menu-panel={index}
              hidden={index !== 0}
            >
              <h3>{menu.name}</h3>
              <p class="menu-panel__desc">{menu.description}</p>

              <div class="courses">
                {menu.courses.map((course) => (
                  <div class="course">
                    <p class="course__name">{course.name}</p>
                    <div class="course__options" data-count={course.options.length}>
                      {course.options.map((option, optionIndex) => (
                        <>
                          {optionIndex > 0 && <span class="course__or">{t.menus.or}</span>}
                          <span class="course__option">{option}</span>
                        </>
                      ))}
                    </div>
                  </div>
                ))}
              </div>

              <p class="menu-panel__note">
                {menu.courses.every((course) => course.options.length === 1)
                  ? t.menus.tastingNote
                  : t.menus.choiceNote}
              </p>

              <a
                class="link-arrow menu-explorer__cta"
                href={site.bookingUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.menus.cta}
                <Icon name="arrow-right" />
              </a>
            </div>
          ))
        }
      </div>

      <p
        class="sr-only"
        aria-live="polite"
        data-explorer-status
        data-label={t.menus.current}
      ></p>
    </div>
  </div>

  <noscript>
    <style>
      /* No JS: every menu is shown, stacked vertically. Undo the grid-cell
         stacking and the visibility-based hiding above. The tab buttons and
         live region have no behaviour without JS, so they are removed rather
         than left as dead controls. */
      .menu-tabs,
      [data-explorer-status] {
        display: none;
      }
      .menu-explorer {
        grid-template-columns: 1fr;
      }
      .menu-panels {
        display: block;
      }
      .menu-panel[data-menu-panel] {
        grid-area: auto;
      }
      .menu-panel[data-menu-panel] + .menu-panel[data-menu-panel] {
        margin-top: 2rem;
      }
      .menu-panel[data-menu-panel][hidden] {
        display: block !important;
        visibility: visible !important;
      }
    </style>
  </noscript>
</section>

<section class="section process" id="tijek" aria-labelledby="process-title">
  <div class="wrap">
    <div class="process__head">
      <h2 id="process-title">{t.how.title}</h2>
      <p class="process__lead">{t.how.lead}</p>
    </div>

    <ol class="steps">
      {
        t.how.steps.map((step, index) => (
          <li class="step">
            <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="action" aria-label={t.action.caption}>
  <figure class="action__figure">
    <img
      src={actionImage.src}
      srcset={actionImage.srcset}
      sizes="100vw"
      width={actionImage.width}
      height={actionImage.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <figcaption class="action__caption">{t.action.caption}</figcaption>
  </figure>
</section>

<section class="section included" id="ukljuceno" aria-labelledby="included-title">
  <div class="wrap included__grid">
    <div class="included__text">
      <h2 id="included-title">{t.included.title}</h2>
      <p class="included__lead">{t.included.lead}</p>
      <p class="included__note">{t.included.note}</p>
    </div>

    <dl class="included__list">
      {
        t.included.rows.map((row) => (
          <div class="included__row">
            <dt>{row.item}</dt>
            <dd>{row.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<section class="section gallery-teaser" id="galerija" aria-labelledby="gallery-title">
  <div class="wrap">
    <div class="gallery-teaser__head">
      <h2 id="gallery-title">{t.galleryTeaser.title}</h2>
      <p class="gallery-teaser__lead">{t.galleryTeaser.lead}</p>
    </div>

    <div class="gallery-teaser__grid">
      {
        teaserItems.map((item, index) => (
          <figure class="gallery-teaser__item">
            <button
              class="lightbox-trigger"
              type="button"
              data-lightbox={item.full}
              data-lightbox-alt={item.alt}
              data-lightbox-caption={item.caption}
              aria-label={`${t.lightbox.open}: ${item.caption}`}
            >
              <img
                src={item.src}
                srcset={item.srcset}
                sizes="(max-width: 680px) 100vw, 45rem"
                width={item.width}
                height={item.height}
                alt=""
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </button>
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>

    <div class="gallery-teaser__foot">
      <p class="gallery-teaser__note">{t.galleryTeaser.note}</p>
      <a class="link-arrow" href={routes.gallery[lang]}>
        {t.galleryTeaser.cta}
        <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</section>

<section class="statement" aria-label={t.statement.label}>
  <div class="wrap statement__inner">
    <blockquote>
      <p>{t.statement.text}</p>
    </blockquote>
    <p class="statement__attribution">{t.statement.attribution}</p>
  </div>
</section>

<section class="section faq" id="pitanja" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <div class="faq__text">
      <h2 id="faq-title">{t.faq.title}</h2>
      <p class="faq__lead">{t.faq.lead}</p>
    </div>

    <dl class="faq__list">
      {
        t.faq.items.map((item) => (
          <div class="faq__item">
            <dt class="faq__q">{item.q}</dt>
            <dd class="faq__a">{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<CtaBand
  title={t.cta.title}
  lead={t.cta.lead}
  button={t.cta.button}
/>

<ContactPanel lang={lang} />

<script is:inline>
  (() => {
    const tabs = Array.from(document.querySelectorAll('.menu-tab[data-menu-tab]'));
    const panels = Array.from(document.querySelectorAll('.menu-panel[data-menu-panel]'));

    if (!tabs.length || tabs.length !== panels.length) return;

    const status = document.querySelector('[data-explorer-status]');
    let announced = 0;

    const select = (activeIndex) => {
      tabs.forEach((tab, index) => {
        tab.setAttribute('aria-pressed', String(index === activeIndex));
      });

      panels.forEach((panel, index) => {
        const active = index === activeIndex;
        panel.hidden = !active;

        if (active) {
          // The sheet keeps its height by hiding panels with visibility, which
          // also stops the CSS entry animation from restarting on its own.
          panel.style.animation = 'none';
          void panel.offsetWidth;
          panel.style.animation = '';
        }
      });

      // The toggle group announces its pressed state only while the button has
      // focus; a polite live region carries which menu is now on screen.
      if (status && activeIndex !== announced) {
        const name = panels[activeIndex]?.querySelector('h3')?.textContent?.trim();
        if (name) status.textContent = `${status.dataset.label}: ${name}`;
        announced = activeIndex;
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
    });
  })();
</script>
