---
import { routes, site } from '../config';
import { getContent } from '../lib/content';

interface Props {
  lang: 'hr' | 'en';
}

const { lang } = Astro.props;
const t = getContent(lang);
const year = site.year;
---

<footer class="site-footer">
  <div class="wrap">
    <p class="footer__brand">{site.name}</p>

    <div class="footer__bottom">
      <nav class="footer__links" aria-label={t.footer.navLabel}>
        <a href={routes.home[lang]}>{t.nav.home}</a>
        <a href={routes.gallery[lang]}>{t.nav.gallery}</a>
        <a href={`${routes.home[lang]}#jelovnici`}>{t.nav.menu}</a>
        <a href={routes.privacy[lang]}>{t.nav.privacy}</a>
      </nav>

      <div class="footer__slogan">
        <span>{t.footer.areaText}</span>
        <a href={site.bookingUrl} target="_blank" rel="noopener noreferrer" class="footer__booking">
          {t.footer.bookingLink}
          <span class="sr-only">{t.newWindow}</span>
        </a>
      </div>

      <div class="footer__copyright">
        <span>© {year} {site.name}</span>
        <span>{t.footer.rights}</span>
        <button class="footer__consent" type="button" data-consent-settings>
          {t.consent.settings}
        </button>
      </div>
    </div>
  </div>
</footer>
