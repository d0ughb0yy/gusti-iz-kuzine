---
import { routes, site } from '../config';
import { getContent, type Lang } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<section class="contact" id="kontakt" aria-labelledby="contact-title">
  <div class="wrap contact__grid">
    <div class="contact__text">
      <h2 id="contact-title">{t.contact.title}</h2>
      <p class="contact__lead">{t.contact.lead}</p>
      <p class="contact__note">{t.contact.note}</p>
    </div>

    <div class="contact__panel">
      <form
        class="contact-form"
        aria-label={t.contact.formLabel}
        action="https://api.web3forms.com/submit"
        method="POST"
        data-contact-form
        data-sending={t.contact.sending}
        data-success={t.contact.success}
        data-error={t.contact.error}
      >
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="subject" value={t.contact.subject} />
        <input type="hidden" name="from_name" value={site.name} />
        <input type="hidden" name="redirect" value={new URL(routes.thanks[lang], site.url).href} />
        <input
          class="contact-form__botcheck"
          type="checkbox"
          name="botcheck"
          tabindex="-1"
          autocomplete="off"
        />
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label class="contact-form__label" for="contact-name">{t.contact.fields.name}</label>
            <input
              id="contact-name"
              class="contact-form__input"
              name="name"
              type="text"
              autocomplete="given-name"
              autocapitalize="sentences"
              aria-describedby="contact-name-hint"
              required
            />
            <p class="contact-form__hint" id="contact-name-hint">{t.contact.hints.name}</p>
          </div>

          <div class="contact-form__field">
            <label class="contact-form__label" for="contact-surname">
              {t.contact.fields.surname}
            </label>
            <input
              id="contact-surname"
              class="contact-form__input"
              name="surname"
              type="text"
              autocomplete="family-name"
              autocapitalize="sentences"
              aria-describedby="contact-surname-hint"
              required
            />
            <p class="contact-form__hint" id="contact-surname-hint">{t.contact.hints.surname}</p>
          </div>
        </div>

        <div class="contact-form__field">
          <label class="contact-form__label" for="contact-email">{t.contact.fields.email}</label>
          <input
            id="contact-email"
            class="contact-form__input"
            name="email"
            type="email"
            autocomplete="email"
            autocapitalize="off"
            aria-describedby="contact-email-hint"
            required
          />
          <p class="contact-form__hint" id="contact-email-hint">{t.contact.hints.email}</p>
        </div>

        <div class="contact-form__field">
          <label class="contact-form__label" for="contact-message">
            {t.contact.fields.message}
          </label>
          <textarea
            id="contact-message"
            class="contact-form__input contact-form__input--message"
            name="message"
            rows="5"
            maxlength="2000"
            autocapitalize="sentences"
            aria-describedby="contact-message-hint"
            required></textarea>
          <p class="contact-form__hint" id="contact-message-hint">{t.contact.hints.message}</p>
        </div>

        <button class="btn contact-form__submit" type="submit">
          {t.contact.fields.submit}
          <Icon name="arrow-right" />
        </button>

        <p
          class="contact-form__status"
          role="status"
          aria-atomic="true"
          data-form-status
          data-state="idle"
          hidden
        ></p>
      </form>

      <p class="contact-form__fallback">
        {t.contact.fallback.before}
        {' '}
        <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        {' '}
        {t.contact.fallback.after}
        {' '}
        <a href={site.bookingUrl} target="_blank" rel="noopener noreferrer">
          {t.contact.fallback.booking}
        </a>
      </p>

      <p class="contact-form__privacy">
        {t.contact.privacy}{' '}
        <a href={routes.privacy[lang]}>{t.contact.privacyLink}</a>
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-contact-form]');
    if (!form) return;

    const status = form.querySelector('[data-form-status]');
    const submit = form.querySelector('button[type="submit"]');

    const setStatus = (state, message) => {
      if (!status) return;
      status.dataset.state = state;
      status.textContent = message;
      status.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (typeof form.reportValidity === 'function' && !form.reportValidity()) {
        return;
      }

      const sending = form.getAttribute('data-sending') || '';
      const success = form.getAttribute('data-success') || '';
      const error = form.getAttribute('data-error') || '';

      setStatus('sending', sending);
      if (submit) submit.disabled = true;
      form.setAttribute('aria-busy', 'true');

      try {
        const payload = new FormData(form);
        // The native fallback needs `redirect`; an AJAX submission needs JSON.
        payload.delete('redirect');

        const response = await fetch(form.action, {
          method: 'POST',
          body: payload,
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error('Request failed');

        const result = await response.json().catch(() => null);
        if (!result || result.success === false) {
          throw new Error('Request failed');
        }

        form.reset();
        setStatus('success', success);

        try {
          if (typeof window.gustiTrack === 'function') {
            window.gustiTrack('contact_submit', {
              form_name: 'contact',
              language: document.documentElement.lang,
            });
          }
        } catch {
          // Analytics must never affect the form's success state.
        }
      } catch {
        setStatus('error', error);
      } finally {
        if (submit) submit.disabled = false;
        form.removeAttribute('aria-busy');
      }
    });
  })();
</script>
