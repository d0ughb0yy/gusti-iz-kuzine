---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThankYouPage from '../components/ThankYouPage.astro';
import { getContent } from '../lib/content';

const lang = 'hr' as const;
const t = getContent(lang);
---

<BaseLayout
  lang={lang}
  current="thanks"
  title={t.thanksPage.metaTitle}
  description={t.thanksPage.metaDescription}
  noindex
>
  <ThankYouPage lang={lang} />
</BaseLayout>
