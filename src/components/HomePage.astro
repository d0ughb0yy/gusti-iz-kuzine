---
import Icon from './Icon.astro';
import CtaBand from './CtaBand.astro';
import { routes, site } from '../config';
import { getContent, getGallery, getImage, type Lang } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);

const heroImage = getImage(t.hero.image);
const portraitImage = getImage('chef-portrait');
const allGallery = getGallery(lang);
const nextPopup = t.popupPage.dates[0];

// A renamed or missing teaser key must fail the build, not silently render
// a broken grid.
const teaserItems = t.galleryTeaser.images.map((key) => {
  const item = allGallery.find((galleryItem) => galleryItem.imageKey === key);
  if (!item) throw new Error(`Unknown image key in galleryTeaser: ${key}`);
  return item;
});

const formatRoutes: Record<string, string> = {
  private: routes.privateDining[lang],
  popup: routes.popup[lang],
  workshops: routes.workshops[lang],
};

// A renamed format key must fail the build, not render an empty link.
const formatItems = t.formats.items.map((item) => {
  const href = formatRoutes[item.key];
  if (!href) throw new Error(`Unknown format key: ${item.key}`);
  // The pop-up stone names its next date, so it reads the same source as the
  // pop-up page instead of carrying a second, drifting copy. The Croatian
  // label ends with a full stop; the sentence supplies its own.
  const nextDate = nextPopup.label.replace(/\.$/, '');
  const fillDate = (value) => value.replace('{date}', nextDate);
  return { ...item, href, text: fillDate(item.text), meta: fillDate(item.meta) };
});
---

<section class="wall-hero" aria-labelledby="hero-name">
  <div class="wrap">
    <div class="wall">
      <div class="wall__name">
        <p class="eyebrow">{t.hero.projectLabel}</p>
        <h1 id="hero-name" aria-label={t.hero.name.join(' ')}>
          {t.hero.name.map((line) => <span class="wall__name-line">{line}</span>)}
        </h1>
      </div>

      <div class="wall__day">
        <p class="wall__day-label">{t.hero.dayLabel}</p>
        <ol class="day-list" role="list">
          {
            t.hero.day.map((entry) => (
              <li class="day-list__item">
                <span class="day-list__time">{entry.time}</span>
                <span class="day-list__label">{entry.label}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <figure class="wall__media">
        <img
          src={heroImage.src}
          srcset={heroImage.srcset}
          sizes="(max-width: 960px) 100vw, 58vw"
          width={heroImage.width}
          height={heroImage.height}
          alt=""
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>

      <div class="wall__intro">
        <p class="wall__lead">{t.hero.lead}</p>

        <div class="wall__actions">
          <a class="btn" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">
            {t.hero.primaryCta}
            <Icon name="external" />
            <span class="sr-only">{t.newWindow}</span>
          </a>
          <a class="link-arrow" href="#program">
            {t.hero.secondaryCta}
            <Icon name="arrow-right" />
          </a>
        </div>

        <p class="wall__note">{t.hero.bookingNote}</p>
      </div>
    </div>
  </div>
</section>

<section class="section formats" id="program" aria-labelledby="formats-title">
  <div class="wrap">
    <header class="formats__head">
      <h2 id="formats-title">{t.formats.title}</h2>
      <p class="formats__lead">{t.formats.lead}</p>
    </header>

    <div class="format-stones">
      {
        formatItems.map((item) => (
          <a
            class:list={[
              'format-stone',
              item.key === 'private' && 'format-stone--lead',
            ]}
            href={item.href}
          >
            <span class="format-stone__meta">{item.meta}</span>
            <span class="format-stone__title">{item.title}</span>
            <span class="format-stone__text">{item.text}</span>
            <span class="format-stone__cta">
              {item.cta}
              <Icon name="arrow-right" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="section story" id="o-kuhanju" aria-labelledby="story-title">
  <div class="wrap story__grid">
    <figure class="story__figure">
      <a
        class="lightbox-trigger"
        href={portraitImage.full}
        data-lightbox={portraitImage.full}
        data-lightbox-alt={portraitImage.alt[lang]}
        data-lightbox-caption={t.intro.who.name}
        aria-label={`${t.lightbox.open}: ${t.intro.who.name}`}
      >
        <img
          src={portraitImage.src}
          srcset={portraitImage.srcset}
          sizes="(max-width: 960px) 100vw, 34rem"
          width={portraitImage.width}
          height={portraitImage.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </a>
    </figure>

    <div class="story__text">
      <h2 id="story-title">{t.intro.title}</h2>

      <div class="story__paragraphs">
        {t.intro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="story__byline">
        <p class="story__name">{t.intro.who.name}</p>
        <p class="story__fact">{t.intro.who.fact}</p>
      </div>

      <a class="link-arrow" href={routes.privateDining[lang]}>
        {t.intro.link}
        <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</section>

<section class="popup-strip" aria-labelledby="popup-strip-title">
  <div class="wrap popup-strip__grid">
    <div class="popup-strip__text">
      <h2 id="popup-strip-title">{t.popupPage.title}</h2>
      <p>{t.popupPage.lead}</p>
    </div>

    <dl class="popup-strip__facts">
      <div class="popup-strip__fact">
        <dt>{t.popupPage.metaLabels.date}</dt>
        <dd>
          <time datetime={nextPopup.iso}>{nextPopup.label}</time>
          <span>{nextPopup.time}</span>
        </dd>
      </div>
      <div class="popup-strip__fact">
        <dt>{t.popupPage.metaLabels.place}</dt>
        <dd>{t.popupPage.place}</dd>
      </div>
      <div class="popup-strip__fact">
        <dt>{t.popupPage.metaLabels.price}</dt>
        <dd>
          {t.popupPage.price}
          <span>{t.popupPage.priceUnit}</span>
        </dd>
      </div>
    </dl>

    <a class="btn btn--light" href={routes.popup[lang]}>
      {t.formats.items[1].cta}
      <Icon name="arrow-right" />
    </a>
  </div>
</section>

<section class="section gallery-teaser" id="galerija" aria-labelledby="gallery-title">
  <div class="wrap">
    <div class="gallery-teaser__head">
      <h2 id="gallery-title">{t.galleryTeaser.title}</h2>
      <p class="gallery-teaser__lead">{t.galleryTeaser.lead}</p>
    </div>

    <div class="gallery-teaser__grid">
      {
        teaserItems.map((item) => (
          <figure class="gallery-teaser__item">
            <a
              class="lightbox-trigger"
              href={item.full}
              data-lightbox={item.full}
              data-lightbox-alt={item.alt}
              data-lightbox-caption={item.caption}
              data-lightbox-group="gallery"
              aria-label={`${t.lightbox.open}: ${item.caption}`}
            >
              <img
                src={item.src}
                srcset={item.srcset}
                sizes="(max-width: 680px) 100vw, 45rem"
                width={item.width}
                height={item.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </a>
          </figure>
        ))
      }
    </div>

    <div class="gallery-teaser__foot">
      <p class="gallery-teaser__note">{t.galleryTeaser.note}</p>
      <a class="link-arrow" href={routes.gallery[lang]}>
        {t.galleryTeaser.cta}
        <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</section>

<CtaBand
  title={t.cta.title}
  lead={t.cta.lead}
  button={t.cta.button}
  newWindow={t.newWindow}
/>
