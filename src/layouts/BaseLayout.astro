---
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/inter-tight/600.css';
import '../styles/theme.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { routes, site } from '../config';
import { getContent, getImage, type CurrentPage, type Lang } from '../lib/content';

interface Props {
  lang: Lang;
  current: CurrentPage;
  title: string;
  description: string;
  ogImage?: string;
  faq?: { q: string; a: string }[];
  noindex?: boolean;
}

const { lang, current, title, description, ogImage = 'istria-market', faq, noindex = false } = Astro.props;
const t = getContent(lang);
const canonical = new URL(Astro.url.pathname, site.url);
const image = getImage(ogImage);
// Scrapers resolve og:image against the page URL, so it must be absolute.
const imageUrl = new URL(image.src, site.url).href;
// The header is transparent only over the home hero, never over a 404 or a
// secondary page that happens to share the "home" route key.
const overlayHeader =
  current === 'home' && [routes.home.hr, routes.home.en].includes(Astro.url.pathname);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description,
  url: site.url,
  image: imageUrl,
  areaServed: {
    '@type': 'AdministrativeArea',
    name: site.serviceArea,
  },
  priceRange: '€€€',
  sameAs: [site.bookingUrl],
};

const faqSchema =
  faq && faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="alternate" hreflang="hr" href={new URL(routes[current].hr, site.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(routes[current].en, site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(routes[current].hr, site.url).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={image.alt[lang]} />
    <meta property="og:locale" content={lang === 'hr' ? 'hr_HR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'hr' ? 'en_US' : 'hr_HR'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <meta name="theme-color" content="#f4f0e7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} current={current} overlay={overlayHeader} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />

    <Lightbox labels={t.lightbox} />
    <ConsentBanner lang={lang} />
  </body>
</html>
